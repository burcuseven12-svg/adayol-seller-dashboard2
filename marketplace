      if (catName === "Tüm Kategoriler") {
        renderAllShelves();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }

      // Jump filter simulations
      if (catName === "Ada’da Trend") {
        document.getElementById("trend-sales-anchor").scrollIntoView({ behavior: 'smooth' });
      } else if (catName === "Bugün Teslim") {
        document.getElementById("today-delivery-anchor").scrollIntoView({ behavior: 'smooth' });
      } else if (catName === "Yerel Üreticiler") {
        document.getElementById("flash-sales-anchor").scrollIntoView({ behavior: 'smooth' });
