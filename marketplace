            </div>
          </div>
          <button onclick="addGenericToCart('${product.title}', ${product.price}, '${product.store}', '${product.image}')" class="w-full mt-1.5 bg-terracotta-light hover:bg-terracotta hover:text-white text-terracotta text-[9px] py-1 rounded font-bold transition-colors">
            Ekle
          </button>
        </div>
      `;
    }

    // Dynamic Today product card rendering
    function createTodayProductCard(product) {
      return `
        <div class="product-card bg-white border border-[#EFE3DA] rounded-lg p-2 shrink-0 w-[125px] flex flex-col justify-between">
          <div class="relative aspect-square w-full bg-ivory rounded overflow-hidden">
            <img class="w-full h-full object-cover" src="${product.image}" alt="${product.title}" onerror="this.src='https://placehold.co/150x150/FAF7F3/E96B3C?text=${product.title}'">
            <span class="absolute top-1 left-1 bg-olive text-white text-[8px] px-1 rounded font-black">BUGÜN TESLİM</span>
          </div>
          <div class="mt-1.5 space-y-1">
            <h4 class="text-[10px] text-charcoal font-bold line-clamp-2 leading-tight min-h-[24px]">${product.title}</h4>
            <div class="flex items-center justify-between text-[10px] font-extrabold text-charcoal">
              <span class="text-terracotta">₺${product.price}</span>
              <span class="text-muted text-[8px]">📍 ${product.location}</span>
            </div>
          </div>
          <button onclick="addGenericToCart('${product.title}', ${product.price}, '${product.store}', '${product.image}')" class="w-full mt-1.5 border border-terracotta hover:bg-terracotta hover:text-white text-terracotta text-[9px] py-1 rounded font-bold transition-colors flex items-center justify-center gap-1">
            <span>Sepete Ekle</span>
          </button>
        </div>
      `;
    }

    function renderFilteredFlash(items) {
      const container = document.getElementById("flash-grid");
      if (items.length > 0) {
        container.innerHTML = items.map(p => createFlashProductCard(p)).join('');
        container.parentElement.classList.remove("hidden");
      } else {
        container.innerHTML = `<p class="text-xs text-muted col-span-full py-6 text-center">Eşleşen flash ürünü bulunamadı.</p>`;
      }
    }

    function renderFilteredTrend(items) {
      const container = document.getElementById("trend-grid");
      if (items.length > 0) {
        container.innerHTML = items.map(p => createTrendProductCard(p)).join('');
        container.parentElement.classList.remove("hidden");
      } else {
        container.innerHTML = `<p class="text-xs text-muted col-span-full py-6 text-center">Eşleşen trend ürünü bulunamadı.</p>`;
      }
    }

    function renderFilteredToday(items) {
      const container = document.getElementById("today-carousel");
      if (items.length > 0) {
        container.innerHTML = items.map(p => createTodayProductCard(p)).join('');
      } else {
        container.innerHTML = `<p class="text-xs text-muted py-6">Bu bölgede teslim edilebilir ürün bulunamadı.</p>`;
      }
    }

    function filterLocationProducts(loc) {
      if (loc === "Tümü") {
        renderFilteredToday(TODAY_PRODUCTS);
      } else {
        const filtered = TODAY_PRODUCTS.filter(p => p.location === loc);
        renderFilteredToday(filtered);
      }
      toastMessage(`${loc} konumuna uygun teslimat ürünleri listelendi.`);
    }

    // SEARCH FILTER ENGINE
    function initSearchEngine() {
      const input = document.getElementById("search-input");
      const clearBtn = document.getElementById("clear-search");
      const searchBtn = document.getElementById("search-btn");

      const handleSearch = () => {
        const query = input.value.trim().toLowerCase();
        if (query.length > 0) {
          clearBtn.classList.remove("hidden");
          const filteredFlash = FLASH_PRODUCTS.filter(p => 
            p.title.toLowerCase().includes(query) || 
            p.category.toLowerCase().includes(query) ||
            p.store.toLowerCase().includes(query) ||
            p.location.toLowerCase().includes(query)
          );
          const filteredTrend = TREND_PRODUCTS.filter(p => 
            p.title.toLowerCase().includes(query) || 
            p.category.toLowerCase().includes(query) ||
            p.store.toLowerCase().includes(query) ||
            p.location.toLowerCase().includes(query)
          );
          renderFilteredFlash(filteredFlash);
          renderFilteredTrend(filteredTrend);
        } else {
          clearBtn.classList.add("hidden");
          renderAllShelves();
        }
      };

      input.addEventListener("input", handleSearch);
      searchBtn.addEventListener("click", handleSearch);

      clearBtn.addEventListener("click", () => {
        input.value = "";
        clearBtn.classList.add("hidden");
        renderAllShelves();
      });
    }

    
    // Basket Actions
    function addToCart(id) {
      const product = FLASH_PRODUCTS.find(p => p.id === id);
      if (!product) return;

      const existing = cart.find(item => item.id === id);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...product, quantity: 1 });
      }

      updateCartUI();
      toastMessage(`"${product.title.substring(0, 20)}..." sepetinize eklendi!`);
    }

    function addGenericToCart(title, price, store, image) {
      const uniqueId = Math.floor(Math.random() * 100000);
      const item = {
        id: uniqueId,
        title: title,
        price: price,
        store: store,
        image: image,
        quantity: 1
      };
      cart.push(item);
      updateCartUI();
      toastMessage(`"${title}" sepetinize eklendi!`);
    }

    function updateCartUI() {
      const counter = document.getElementById("cart-counter");
      const itemsContainer = document.getElementById("cart-items");
      const totalContainer = document.getElementById("cart-total-price");

      const totalQuantity = cart.reduce((acc, curr) => acc + curr.quantity, 0);
      counter.innerText = totalQuantity;

      if (cart.length === 0) {
        itemsContainer.innerHTML = `<p class="text-xs text-center text-muted py-8">Sepetinizde ürün bulunmamaktadır.</p>`;
        totalContainer.innerText = "₺0.00";
        return;
      }

      itemsContainer.innerHTML = cart.map(item => `
        <div class="flex items-center gap-2.5 bg-ivory p-2 rounded border border-border">
          <img src="${item.image}" alt="${item.title}" class="w-10 h-10 rounded object-cover">
          <div class="flex-1 min-w-0">
            <h4 class="text-[11px] font-bold text-charcoal truncate">${item.title}</h4>
            <p class="text-[9px] text-muted">${item.store}</p>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="text-xs font-bold text-terracotta">₺${item.price}</span>
              <span class="text-[10px] text-muted">Miktar: ${item.quantity}</span>
            </div>
          </div>
          <button onclick="removeFromCart(${item.id})" class="text-muted hover:text-red-500 font-bold px-1.5 text-xs">✕</button>
        </div>
      `).join('');

      const totalPrice = cart.reduce((acc, curr) => acc + (curr.price * curr.quantity), 0);
      totalContainer.innerText = `₺${totalPrice.toLocaleString()}`;
    }

    function removeFromCart(id) {
      cart = cart.filter(item => item.id !== id);
      updateCartUI();
    }

    function toggleCartPanel() {
      const panel = document.getElementById("cart-panel");
      panel.classList.toggle("hidden");
    }

    function checkoutMock() {
      if (cart.length === 0) {
        toastMessage("Lütfen sepetinize önce ürün ekleyin.");
        return;
      }
      toastMessage("Ödeme sayfasına yönlendiriliyorsunuz... Siparişiniz en kısa sürede kapınızda olacak!");
      cart = [];
      updateCartUI();
      setTimeout(() => { toggleCartPanel(); }, 1500);
    }

    
    // Favorites Actions
    function toggleFavorite(id) {
      const index = favorites.indexOf(id);
      if (index > -1) {
        favorites.splice(index, 1);
        toastMessage("Ürün beğenilenlerden kaldırıldı.");
      } else {
        favorites.push(id);
        toastMessage("Ürün favorilerinize başarıyla kaydedildi! ❤️");
      }
      updateFavoritesUI();
      renderFilteredFlash(FLASH_PRODUCTS); // Force-update hearts
    }

    function updateFavoritesUI() {
      const counter = document.getElementById("fav-counter");
      const container = document.getElementById("fav-items");

      counter.innerText = favorites.length;

      if (favorites.length === 0) {
        container.innerHTML = `<p class="text-xs text-center text-muted py-8">Favorileriniz boş.</p>`;
        return;
      }

      const favProducts = FLASH_PRODUCTS.filter(p => favorites.includes(p.id));
      container.innerHTML = favProducts.map(item => `
        <div class="flex items-center gap-2.5 bg-ivory p-2 rounded border border-border">
          <img src="${item.image}" alt="${item.title}" class="w-10 h-10 rounded object-cover">
          <div class="flex-1 min-w-0">
            <h4 class="text-[11px] font-bold text-charcoal truncate">${item.title}</h4>
            <p class="text-[9px] text-muted">${item.store}</p>
            <span class="text-xs font-bold text-terracotta">₺${item.price}</span>
          </div>
          <button onclick="toggleFavorite(${item.id})" class="text-terracotta hover:scale-110 px-1.5 text-xs">❤️</button>
        </div>
      `).join('');
    }

    function toggleFavoritesPanel() {
      const panel = document.getElementById("fav-panel");
      panel.classList.toggle("hidden");
    }

    
    // Countdown Timer for Flash shelf
    function initCountdown() {
      const timerEl = document.getElementById("countdown-timer");
      let hours = 2, minutes = 43, seconds = 18;

      setInterval(() => {
        seconds--;
        if (seconds < 0) {
          seconds = 59;
          minutes--;
          if (minutes < 0) {
            minutes = 59;
            hours--;
            if (hours < 0) {
              hours = 3; minutes = 0; seconds = 0;
            }
          }
        }
        const hStr = hours < 10 ? '0' + hours : hours;
        const mStr = minutes < 10 ? '0' + minutes : minutes;
        const sStr = seconds < 10 ? '0' + seconds : seconds;
        timerEl.innerText = `⏱ ${hStr}:${mStr}:${sStr}`;
      }, 1000);
    }

    
    // Live Ticker Actions
    function initLiveActivity() {
      // Top line ticker loop
      setInterval(() => {
        const textEl = document.getElementById("live-activity-text");
        const container = document.getElementById("live-carousel-container");
        
        container.style.opacity = "0";
        setTimeout(() => {
          liveTxIndex = (liveTxIndex + 1) % LIVE_TRANSACTIONS.length;
          textEl.innerText = LIVE_TRANSACTIONS[liveTxIndex].text;
          container.style.opacity = "1";
        }, 300);

      }, 7000);

      // Compact dynamic info card ticker loop
      setInterval(() => {
        const locations = ["Girne", "Lefkoşa", "Gazimağusa", "Güzelyurt", "Karpaz"];
        const products = ["Sızma Zeytinyağı", "Taze Kıbrıs Hellimi", "Con Türk Kahvesi", "El Emeği Seramik Kupa", "Karpaz Süzme Balı"];
        const times = ["Az önce", "1 dk önce", "2 dk önce", "3 dk önce"];

        const randomLoc = locations[Math.floor(Math.random() * locations.length)];
        const randomProduct = products[Math.floor(Math.random() * products.length)];
        const randomTime = times[Math.floor(Math.random() * times.length)];

        document.getElementById("live-purchase-card-text").innerText = `Az önce ${randomLoc}'den ${randomProduct} sipariş edildi`;
        document.getElementById("live-purchase-card-time").innerText = randomTime;

        // Optionally fire a bottom toast too
        triggerNotificationToast(randomLoc, randomProduct);
      }, 11000);
    }

    function triggerNotificationToast(location, product) {
      const names = ["Ayla K.", "Mustafa S.", "Ceren Y.", "Kemal B.", "Aylin H."];
      const randomName = names[Math.floor(Math.random() * names.length)];
      
      const toast = document.getElementById("live-toast");
      const desc = document.getElementById("toast-desc");
      const title = document.getElementById("toast-title");

      title.innerHTML = `🛒 Canlı Alışveriş • <span class="text-emerald-400">Yeni Sipariş</span>`;
      desc.innerText = `${randomName} (${location}), "${product}" satın aldı!`;
      
      toast.classList.remove("hidden");

      setTimeout(() => {
        closeToast();
      }, 4000);
    }

    function toastMessage(msg) {
      const toast = document.getElementById("live-toast");
      const desc = document.getElementById("toast-desc");
      const title = document.getElementById("toast-title");

      title.innerText = "İşlem Bildirimi";
      desc.innerText = msg;
      
      toast.classList.remove("hidden");

      setTimeout(() => {
        closeToast();
      }, 4000);
    }

    function closeToast() {
      document.getElementById("live-toast").classList.add("hidden");
    }

    function scrollContainer(id, direction) {
      const el = document.getElementById(id);
      if (el) {
        el.scrollBy({ left: 150 * direction, behavior: 'smooth' });
      }
    }

    // Dynamic numeric counters shifting realistically
    function initDynamicCounters() {
      setInterval(() => {
        const activeStores = document.getElementById("active-stores-count");
        const deliveredOrders = document.getElementById("live-delivered-orders");
        
        const storeShift = Math.floor(Math.random() * 3) - 1; // -1, 0, or 1
        let valStores = parseInt(activeStores.innerText) + storeShift;
        if (valStores < 32) valStores = 32;
        if (valStores > 45) valStores = 45;
        activeStores.innerText = valStores;

        const orderShift = Math.floor(Math.random() * 2) + 1; // +1 or +2
        deliveredOrders.innerText = parseInt(deliveredOrders.innerText) + orderShift;
      }, 8000);
    }
  </script>
</body>
</html>
