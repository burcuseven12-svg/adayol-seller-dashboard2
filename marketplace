        }`;
        button.innerHTML = `<span>${cat.icon}</span> <span>${cat.name}</span>`;
        button.onclick = () => selectCategory(button, cat.name);
        container.appendChild(button);
      });
    }

    function selectCategory(activeBtn, catName) {
      const buttons = document.querySelectorAll("#categories-container button");
      buttons.forEach(btn => {
        btn.className = "px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all duration-150 border border-border bg-white text-charcoal hover:border-terracotta hover:text-terracotta flex items-center gap-1.5";
